<Window x:Class="RankLens.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RankLens" Height="520" Width="1000"
        MinHeight="360" MinWidth="700" Closing="WindowClosing">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="28" FontWeight="SemiBold" Text="RankLens" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="DarkSlateGray" Text="排名截圖辨識器" />
        <StackPanel Grid.Row="2" Margin="0,24,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="排名週星期一：" />
            <DatePicker x:Name="RankingMondayPicker" Margin="8,0,4,0" SelectedDateFormat="Short" SelectedDateChanged="RankingMondayChanged" />
            <TextBlock x:Name="WeekRangeText" Margin="4,0,12,0" VerticalAlignment="Center" Foreground="DarkSlateGray" />
            <Button Click="SelectImagesClick" Content="選擇截圖" Padding="12,6" />
            <Button Margin="8,0,0,0" Click="SelectFolderClick" Content="選擇資料夾" Padding="12,6" />
            <Button Margin="8,0,0,0" Click="RecognizeClick" Content="開始辨識" Padding="12,6" />
            <Button Margin="8,0,0,0" Click="WriteWorkbookClick" Content="寫入 Excel" Padding="12,6" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="最低信心度：" />
            <TextBox x:Name="ConfidenceTextBox" Width="56" Margin="8,0,16,0" VerticalContentAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="執行模式：" />
            <ComboBox x:Name="ExecutionModeComboBox" Width="100" Margin="8,0,16,0" SelectionChanged="ExecutionModeChanged" />
            <TextBlock VerticalAlignment="Center" Text="GPU：" />
            <ComboBox x:Name="AdapterComboBox" Width="180" Margin="6,0,12,0" SelectedValuePath="Name">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                        <Setter Property="ToolTip" Value="{Binding Reason}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <TextBlock VerticalAlignment="Center" Text="輸出資料夾：" />
            <TextBox x:Name="OutputFolderTextBox" Width="280" Margin="8,0,8,0" VerticalContentAlignment="Center" />
            <Button Click="ChooseOutputFolderClick" Content="瀏覽" Padding="10,4" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="Log 保留天數：" />
            <TextBox x:Name="LogDaysTextBox" Width="40" Margin="6,0,4,0" VerticalContentAlignment="Center" />
            <TextBlock VerticalAlignment="Center" Text="容量 MB：" />
            <TextBox x:Name="LogSizeTextBox" Width="52" Margin="6,0,0,0" VerticalContentAlignment="Center" />
            <Button Margin="12,0,0,0" Click="ResetSettingsClick" Content="重設設定" Padding="10,4" />
            <TextBlock x:Name="LanguageStatus" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="DarkSlateGray" />
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,24,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <ProgressBar x:Name="BatchProgress" Width="220" Height="18" Minimum="0" Maximum="100" />
                <TextBlock x:Name="BatchStatus" Margin="12,0,0,0" VerticalAlignment="Center" Text="尚未選取圖片" />
                <Button x:Name="CancelBatchButton" Margin="12,0,0,0" Click="CancelBatchClick" Content="取消" IsEnabled="False" Padding="12,3" />
                <Button Margin="8,0,0,0" Click="SelectCandidateClick" Content="選取候選" Padding="10,3" />
                <Button Margin="4,0,0,0" Click="MoveRankClick" Content="套用新名次" Padding="10,3" />
                <Button Margin="4,0,0,0" Click="KeepBothClick" Content="保留此筆" Padding="10,3" />
                <Button Margin="4,0,0,0" Click="IgnoreCandidateClick" Content="忽略新資料" Padding="10,3" />
            </StackPanel>
            <TextBox x:Name="BatchFailureDetails" Grid.Row="1" Margin="0,8,0,0" MaxHeight="72"
                     IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Visibility="Collapsed" />
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" BorderBrush="LightGray" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" x:Name="CandidatesGrid" SelectionChanged="CandidateSelectionChanged" CellEditEnding="CandidateCellEditEnding" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="確認">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="CandidateSelectionCheckBoxClick" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridComboBoxColumn Header="分類" SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="排名" Binding="{Binding Rank, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="指揮官名稱" Binding="{Binding CommanderName, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="同盟名稱" Binding="{Binding AllianceName, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Header="確認無同盟">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding NoAllianceConfirmed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Click="NoAllianceCheckBoxClick" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="積分" Binding="{Binding Score, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="信心度" Binding="{Binding OverallConfidence, StringFormat={}{0:P0}}" IsReadOnly="True" />
                    <DataGridTextColumn Header="狀態" Binding="{Binding ReviewStatus}" IsReadOnly="True" />
                </DataGrid.Columns>
                </DataGrid>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="來源圖片預覽" FontWeight="SemiBold" />
                        <TextBlock x:Name="SourceImageLabel" Margin="0,4,0,8" TextWrapping="Wrap" Foreground="Gray" />
                        <ListBox x:Name="SourceList" Height="48" Margin="0,0,0,8" SelectionChanged="SourceSelectionChanged" DisplayMemberPath="ImagePath" />
                        <TextBlock x:Name="SourceGeometryLabel" Margin="0,0,0,8" Foreground="Gray" />
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="縮放：" />
                            <Slider x:Name="SourceZoomSlider" Width="140" Minimum="0.5" Maximum="3" Value="1" TickFrequency="0.25" IsSnapToTickEnabled="True" ValueChanged="SourceZoomChanged" />
                            <TextBlock x:Name="SourceZoomLabel" Margin="8,0,0,0" VerticalAlignment="Center" Text="100%" />
                        </StackPanel>
                        <Border BorderBrush="LightGray" BorderThickness="1" Height="220">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid x:Name="SourceCanvasHost" LayoutTransform="{x:Null}">
                                    <Image x:Name="SourceImagePreview" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Canvas x:Name="SourceOverlay" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Rectangle x:Name="SourceHighlight" Fill="#55FFD700" Stroke="Goldenrod" StrokeThickness="2" />
                                    </Canvas>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
