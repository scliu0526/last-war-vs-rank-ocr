<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.1" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <!-- Keep a local model installation available when launching the normal
       bin/Release executable. The publish script also stages these files for
       the distributable ZIP. -->
  <ItemGroup>
    <None Include="..\models\manifest.json" Condition="Exists('..\models\manifest.json')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\manifest.json" />
    <None Include="..\models\PP-OCRv5_det.onnx" Condition="Exists('..\models\PP-OCRv5_det.onnx')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\PP-OCRv5_det.onnx" />
    <None Include="..\models\PP-OCRv5_rec.onnx" Condition="Exists('..\models\PP-OCRv5_rec.onnx')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\PP-OCRv5_rec.onnx" />
    <None Include="..\models\ppocrv5_dict.txt" Condition="Exists('..\models\ppocrv5_dict.txt')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\ppocrv5_dict.txt" />
    <None Include="..\models\korean_PP-OCRv5_rec.onnx" Condition="Exists('..\models\korean_PP-OCRv5_rec.onnx')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\korean_PP-OCRv5_rec.onnx" />
    <None Include="..\models\korean_PP-OCRv5_rec.yml" Condition="Exists('..\models\korean_PP-OCRv5_rec.yml')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\korean_PP-OCRv5_rec.yml" />
    <None Include="..\models\th_PP-OCRv5_rec.onnx" Condition="Exists('..\models\th_PP-OCRv5_rec.onnx')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\th_PP-OCRv5_rec.onnx" />
    <None Include="..\models\th_PP-OCRv5_rec.yml" Condition="Exists('..\models\th_PP-OCRv5_rec.yml')" CopyToOutputDirectory="PreserveNewest" TargetPath="models\th_PP-OCRv5_rec.yml" />
  </ItemGroup>

</Project>
